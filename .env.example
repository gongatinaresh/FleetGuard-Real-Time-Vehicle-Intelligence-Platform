# Copy to .env before running Docker Compose. Replace the placeholder password.
POSTGRES_DB=vehicle_geofence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password

# Browser-facing URLs; these must be reachable from the host browser.
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
